<?xml version="1.0" encoding="utf-8"?>
<!-- Brillo superior + borde fino que aparece cuando la tarjeta recibe el foco -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#3DFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <stroke android:width="1.5dp" android:color="#73FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
