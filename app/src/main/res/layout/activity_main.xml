<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Cabecera: botones a la izquierda, reloj y fecha a la derecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingTop="34dp"
            android:paddingEnd="56dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnTvSettings"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/round_button"
                        android:clickable="true"
                        android:contentDescription="@string/tv_settings"
                        android:defaultFocusHighlightEnabled="false"
                        android:focusable="true"
                        android:padding="13dp"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/button_icon" />

                    <ImageView
                        android:id="@+id/btnCustomize"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/round_button"
                        android:clickable="true"
                        android:contentDescription="@string/customize"
                        android:defaultFocusHighlightEnabled="false"
                        android:focusable="true"
                        android:padding="14dp"
                        android:src="@drawable/ic_tune"
                        android:tint="@color/button_icon" />
                </LinearLayout>

                <TextView
                    android:id="@+id/headerHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alpha="0"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/clockTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:textColor="@color/text_primary"
                        android:textSize="64sp" />

                    <TextView
                        android:id="@+id/clockAmPm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_secondary"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/clockDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_secondary"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdgeLength="64dp"
            android:fillViewport="true"
            android:focusable="false"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="72dp">

                <TextView
                    android:id="@+id/favTitle"
                    style="@style/SectionTitle"
                    android:text="@string/favorites" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/favList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingStart="56dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="56dp"
                        android:paddingBottom="4dp"
                        android:scrollbars="none" />

                    <TextView
                        android:id="@+id/favEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="56dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:text="@string/favorites_empty"
                        android:textColor="@color/text_tertiary"
                        android:textSize="17sp"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/appsTitle"
                    style="@style/SectionTitle"
                    android:layout_marginTop="10dp"
                    android:text="@string/apps" />

                <com.majo.tvhome.FullHeightRecyclerView
                    android:id="@+id/gridList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="56dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="56dp"
                    android:scrollbars="none" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/moveHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/pill"
        android:paddingStart="28dp"
        android:paddingTop="14dp"
        android:paddingEnd="28dp"
        android:paddingBottom="14dp"
        android:text="@string/move_hint"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:visibility="gone" />

    <!-- Menú contextual de una app (pulsación larga en OK o botón de menú) -->
    <FrameLayout
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/menuPanel"
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/menu_panel"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/menuTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="16dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <LinearLayout
                android:id="@+id/menuItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
